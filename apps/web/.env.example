# Environment variables placeholder
# NEXT_PUBLIC_* variables are exposed to the browser.
# Add secrets in Vercel dashboard or a .env.local file (not committed).
NEXT_PUBLIC_SITE_NAME=UNC BCI Project

# Vercel Blob storage (required for news persistence on Vercel)
# Create a Blob store in Vercel dashboard → Storage → Create → Blob
# Then copy the read-write token here or add it in Vercel env vars.
# When unset, the app falls back to local filesystem (for development).
BLOB_READ_WRITE_TOKEN=
