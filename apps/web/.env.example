# Environment variables placeholder
# NEXT_PUBLIC_* variables are exposed to the browser.
# Add secrets in Vercel dashboard or a .env.local file (not committed).
NEXT_PUBLIC_SITE_NAME=UNC BCI Project

# Supabase (PostgreSQL) — required for news persistence on Vercel.
# 1. Create a free project at https://supabase.com
# 2. Run supabase/schema.sql in the SQL Editor to create the news table.
# 3. Copy these values from Settings → API.
# When both are unset, the app falls back to local JSON files (for development).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
